[[0.64, 1.96, "The day I saw my husband"], [1.96, 3.05, "with another woman,"], [3.05, 4.7, "I thought I knew why he stopped"], [4.7, 6.18, "looking at me the same way."], [7.66, 9.04, "It started months before."], [10.24, 11.23, "Every morning,"], [11.23, 12.95, "I'd stand in front of the mirror,"], [12.95, 14.54, "trying to hide the places where my"], [14.54, 16.24, "scalp was becoming more visible."], [17.24, 18.85, "I'd change my hairstyle."], [18.85, 20.15, "Avoid pictures."], [20.15, 21.68, "Pretend it didn't bother me."], [22.94, 23.6, "But it did."], [25.04, 26.65, "So when I saw him holding"], [26.65, 27.71, "another woman's hand,"], [27.71, 29.04, "I blamed myself."], [30.94, 32.22, "Maybe I wasn't beautiful"], [32.22, 33.02, "enough anymore."], [37.04, 38.3, "After we separated,"], [38.3, 40.4, "I spent weeks looking in the mirror,"], [40.4, 42.18, "wondering what I'd done wrong."], [47.22, 48.3, "Until one morning,"], [48.3, 49.38, "something changed."], [50.64, 52.54, "I realized his betrayal wasn't"], [52.54, 54.12, "a reflection of my worth."], [55.04, 56.71, "And I was tired of treating"], [56.71, 57.88, "myself like it was."], [60.44, 62.38, "I started learning more about my hair."], [63.24, 64.51, "I discovered that hair"], [64.51, 66.43, "naturally goes through growing,"], [66.43, 67.87, "resting, and shedding phases."], [67.87, 69.25, "And changes can happen"], [69.25, 70.52, "for different reasons."], [71.46, 72.94, "I wanted to understand my"], [72.94, 74.54, "body instead of blaming it."], [75.62, 76.71, "So I started making"], [76.71, 77.98, "time for myself again."], [78.84, 80.3, "That's when I discovered NURA."], [81.14, 82.53, "A little reminder to make"], [82.53, 84.48, "self-care part of my everyday life."], [85.66, 86.52, "Not for him."], [87.44, 89.18, "Not to prove anything to anyone."], [89.94, 91.19, "But for the woman I'd"], [91.19, 92.26, "forgotten to love."], [92.96, 93.7, "Myself."], [94.84, 96.79, "NURA. Your hair deserves care."], [96.79, 97.82, "And so do you."]]